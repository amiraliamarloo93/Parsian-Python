{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(:)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(وگرنه|وگرنه_اگر|بگیر|در_پایان)\\b.*$"
  }
}
